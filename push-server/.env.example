# Copy to .env on the server (chmod 600). Never commit the real file.
# VAPID key pair: the public key must equal VAPID_PUBLIC_KEY in components/admin/data/push.ts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional
# VAPID_SUBJECT=mailto:support@brightonsolution.com
# PUSH_SERVER_LABEL=Hostinger VPS
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  (default: service-account.json next to index.js)
