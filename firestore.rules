rules_version = '2';

// BrightonSolution — Firestore security rules.
// Field lists and limits mirror lib/firebase/schema.ts; change both together.
// Public visitors may only CREATE validated documents; nothing is publicly readable.
// New fields are always optional and the key lists are only ever extended, so payloads from
// older clients (pages cached by the service worker) stay valid.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['support@brightonsolution.com']
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function reqStr(d, k, minLen, maxLen) {
      return d[k] is string && d[k].size() >= minLen && d[k].size() <= maxLen;
    }

    function optStr(d, k, maxLen) {
      return !(k in d) || (d[k] is string && d[k].size() <= maxLen);
    }

    function optInt(d, k, minVal, maxVal) {
      return !(k in d) || (d[k] is int && d[k] >= minVal && d[k] <= maxVal);
    }

    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }

    function isId(d, k) {
      return d[k] is string && d[k].matches('^[A-Za-z0-9_-]{8,64}$');
    }

    function optId(d, k) {
      return !(k in d) || d[k] == '' || isId(d, k);
    }

    // --------------------------------------------------------------- contacts

    function validContact(d) {
      return d.keys().hasOnly(['name', 'company', 'email', 'phone', 'service', 'budget', 'message',
                               'page', 'referrer', 'userAgent', 'language', 'timeZone', 'visitorId',
                               'status', 'createdAt'])
        && d.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt'])
        && reqStr(d, 'name', 1, 120)
        && reqStr(d, 'email', 3, 254)
        && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && reqStr(d, 'message', 20, 5000)
        && optStr(d, 'company', 160)
        && optStr(d, 'phone', 40)
        && optStr(d, 'service', 120)
        && optStr(d, 'budget', 60)
        && optStr(d, 'page', 300)
        && optStr(d, 'referrer', 500)
        && optStr(d, 'userAgent', 400)
        && optStr(d, 'language', 35)
        && optStr(d, 'timeZone', 64)
        && optId(d, 'visitorId')
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    // Admins may change the status and a private follow-up note (max 2000 characters, CONTACT_LIMITS.note).
    match /contacts/{id} {
      allow create: if validContact(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'updatedAt'])
        && request.resource.data.status in ['new', 'handled', 'spam']
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string && request.resource.data.note.size() <= 2000))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    // ------------------------------------------------------------------ leads

    // Enquiries from the private landing page (LAUNCH_PATH in lib/site.ts): kind 'brief' is the full
    // project form, kind 'plan' the short request sent from a plan's button. Limits: LEAD_LIMITS.
    function validLead(d) {
      return d.keys().hasOnly(['kind', 'name', 'email', 'phone', 'company', 'projectTypes', 'features',
                               'stage', 'timeline', 'budget', 'plan', 'currency', 'price', 'contactPref',
                               'message', 'page', 'referrer', 'utmSource', 'utmMedium', 'utmCampaign',
                               'utmTerm', 'utmContent', 'userAgent', 'language', 'timeZone', 'visitorId',
                               'status', 'createdAt'])
        && d.keys().hasAll(['kind', 'name', 'email', 'phone', 'status', 'createdAt'])
        && d.kind in ['brief', 'plan']
        && reqStr(d, 'name', 1, 120)
        && reqStr(d, 'email', 3, 254)
        && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && reqStr(d, 'phone', 6, 40)
        && optStr(d, 'company', 160)
        && optStr(d, 'projectTypes', 400)
        && optStr(d, 'features', 800)
        && optStr(d, 'stage', 120)
        && optStr(d, 'timeline', 60)
        && optStr(d, 'budget', 60)
        && optStr(d, 'plan', 40)
        && (!('currency' in d) || d.currency in ['USD', 'INR'])
        && optInt(d, 'price', 0, 100000000)
        && optStr(d, 'contactPref', 40)
        && optStr(d, 'message', 3000)
        && optStr(d, 'page', 300)
        && optStr(d, 'referrer', 500)
        && optStr(d, 'utmSource', 100)
        && optStr(d, 'utmMedium', 100)
        && optStr(d, 'utmCampaign', 100)
        && optStr(d, 'utmTerm', 100)
        && optStr(d, 'utmContent', 100)
        && optStr(d, 'userAgent', 400)
        && optStr(d, 'language', 35)
        && optStr(d, 'timeZone', 64)
        && optId(d, 'visitorId')
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    match /leads/{id} {
      allow create: if validLead(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'won', 'lost', 'spam']
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string && request.resource.data.note.size() <= 2000))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    // -------------------------------------------------------------- pageviews

    // Expiry field: about 26 months ahead (client sends now + 790 days; window allows clock skew).
    // The admin dashboard deletes page views and events older than 790 days each time it is opened.
    function validExpiry(d) {
      return d.expireAt is timestamp
        && d.expireAt > request.time + duration.value(760, 'd')
        && d.expireAt < request.time + duration.value(820, 'd');
    }

    // utmTerm, utmContent and loadMs are optional additions: older cached clients never send them.
    function validPageview(d) {
      return d.keys().hasOnly(['visitorId', 'sessionId', 'path', 'title', 'referrer',
                               'utmSource', 'utmMedium', 'utmCampaign', 'utmTerm', 'utmContent',
                               'durationMs', 'scrollDepth', 'loadMs',
                               'viewportW', 'viewportH', 'screenW', 'screenH', 'language', 'timeZone',
                               'device', 'browser', 'os', 'isNewVisitor', 'pageIndex', 'expireAt', 'createdAt'])
        && d.keys().hasAll(['visitorId', 'sessionId', 'path', 'durationMs', 'expireAt', 'createdAt'])
        && isId(d, 'visitorId')
        && isId(d, 'sessionId')
        && reqStr(d, 'path', 1, 300)
        && optStr(d, 'title', 300)
        && optStr(d, 'referrer', 500)
        && optStr(d, 'utmSource', 100)
        && optStr(d, 'utmMedium', 100)
        && optStr(d, 'utmCampaign', 100)
        && optStr(d, 'utmTerm', 100)
        && optStr(d, 'utmContent', 100)
        && d.durationMs is int && d.durationMs >= 0 && d.durationMs <= 21600000
        && optInt(d, 'scrollDepth', 0, 100)
        && optInt(d, 'loadMs', 0, 120000)
        && optInt(d, 'viewportW', 0, 10000)
        && optInt(d, 'viewportH', 0, 10000)
        && optInt(d, 'screenW', 0, 10000)
        && optInt(d, 'screenH', 0, 10000)
        && optStr(d, 'language', 35)
        && optStr(d, 'timeZone', 64)
        && (!('device' in d) || d.device in ['mobile', 'tablet', 'desktop'])
        && optStr(d, 'browser', 40)
        && optStr(d, 'os', 40)
        && optBool(d, 'isNewVisitor')
        && optInt(d, 'pageIndex', 0, 1000)
        && validExpiry(d)
        && d.createdAt == request.time;
    }

    match /pageviews/{id} {
      allow create: if validPageview(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ----------------------------------------------------------------- events

    function validEvent(d) {
      return d.keys().hasOnly(['visitorId', 'sessionId', 'type', 'label', 'href', 'path', 'expireAt', 'createdAt'])
        && d.keys().hasAll(['visitorId', 'sessionId', 'type', 'path', 'expireAt', 'createdAt'])
        && isId(d, 'visitorId')
        && isId(d, 'sessionId')
        && d.type in ['cta_click', 'outbound', 'play', 'mailto', 'tel', 'form_submit', 'nav',
                      'form_start', 'form_error']
        && optStr(d, 'label', 200)
        && optStr(d, 'href', 500)
        && reqStr(d, 'path', 1, 300)
        && validExpiry(d)
        && d.createdAt == request.time;
    }

    match /events/{id} {
      allow create: if validEvent(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // --------------------------------------------------------------- settings

    // Admin-only dashboard settings: one document, settings/dashboard. excludedVisitors lists the
    // visitor ids of the team's own browsers (at most 500); updatedAt, when sent, is the server time.
    function validSettings(d) {
      return d.keys().hasOnly(['excludedVisitors', 'updatedAt'])
        && d.excludedVisitors is list
        && d.excludedVisitors.size() <= 500
        && (!('updatedAt' in d) || d.updatedAt == request.time);
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && docId == 'dashboard' && validSettings(request.resource.data);
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------- push (admin app)

    // One document per subscribed admin device (id = hex SHA-256 of the endpoint), written by the
    // admin app (components/admin/data/push.ts) and read by the push Cloud Functions (Admin SDK).
    // updatedAt, when sent, is the server time.
    function validPushSubscription(d) {
      return d.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'label', 'userAgent', 'updatedAt'])
        && d.keys().hasAll(['endpoint', 'p256dh', 'auth'])
        && reqStr(d, 'endpoint', 12, 1000)
        && d.endpoint.matches('^https://.+')
        && reqStr(d, 'p256dh', 20, 200)
        && reqStr(d, 'auth', 8, 100)
        && optStr(d, 'label', 100)
        && optStr(d, 'userAgent', 400)
        && (!('updatedAt' in d) || d.updatedAt == request.time);
    }

    match /pushSubscriptions/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && id.matches('^[0-9a-f]{64}$')
        && validPushSubscription(request.resource.data);
    }

    // A request for a test alert: the function sends it to every device, then deletes the document.
    match /pushTests/{id} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // ---------------------------------------------------------- default deny

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
